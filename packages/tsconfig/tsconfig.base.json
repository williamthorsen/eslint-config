// Base TSConfig for Node-only TypeScript: `@tsconfig/strictest` plus the Node/build options that it omits.
// Consumers set `types`, `paths`, `jsx`, and `include`. Node 26 floor.
//
// Every Node/build setting deviates from a TypeScript default; a comment says why it can't be dropped.
// The inlined strictest settings have no such comments: Their rationale belongs to upstream.
{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    // Inlined from `@tsconfig/strictest`, in upstream's order. Not reached through `extends`, because
    // resolvers that don't realpath pnpm symlinks can't follow the second hop. The root test
    // `__tests__/tsconfig-base.tool.test.ts` asserts this block still matches the installed devDependency.
    "strict": true,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "isolatedModules": true,

    "esModuleInterop": true,
    "skipLibCheck": true,

    // Permit `./foo.ts` specifiers; the build step rewrites them on emit.
    "allowImportingTsExtensions": true,
    // Required alongside `allowImportingTsExtensions` once a build clears `noEmit` and emits with `tsc`,
    // which then rewrites the specifier's extension in output and declarations.
    "rewriteRelativeImportExtensions": true,
    // Without this, `lib` follows `target` into the `.full` variant, admitting DOM globals.
    // Each `ESNext.*` entry declares APIs that Node 26 implements and no numbered lib has yet.
    // `ESNext.Decorators` is absent because Node 26 does not implement `Symbol.metadata`.
    "lib": [
      "ES2025",
      "ESNext.Array",
      "ESNext.Collection",
      "ESNext.Date",
      "ESNext.Disposable",
      "ESNext.Error",
      "ESNext.Intl",
      "ESNext.SharedMemory",
      "ESNext.Temporal",
      "ESNext.TypedArrays",
    ],
    // Default is `ES2022` with `Bundler` resolution: wrong for published Node packages.
    "module": "NodeNext",
    // Files with no import or export would otherwise be scripts sharing global scope.
    "moduleDetection": "force",
    // Typecheck-only base; build steps override emit settings.
    "noEmit": true,
    // Inert until a build step clears `noEmit`; keeps published output comment-free.
    "removeComments": true,
    // Default is the latest ES year that the installed TypeScript knows; pin the year that the Node floor implements.
    "target": "ES2025",
  },
}
