{
  "name": "@williamthorsen/strict-lint",
  "version": "11.0.0",
  "description": "Strict linting for ESLint projects",
  "keywords": [
    "cli",
    "eslint",
    "lint"
  ],
  "homepage": "https://github.com/williamthorsen/eslint-config/tree/main/packages/strict-lint#readme",
  "bugs": {
    "url": "https://github.com/williamthorsen/eslint-config/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/williamthorsen/eslint-config.git",
    "directory": "packages/strict-lint"
  },
  "license": "ISC",
  "author": "William Thorsen <william@thorsen.dev> (https://github.com/williamthorsen)",
  "sideEffects": [
    "dist/esm/bin/*.js"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "types": "./dist/esm/index.d.ts"
    },
    "./config": {
      "import": "./dist/esm/defineConfig.js",
      "types": "./dist/esm/defineConfig.d.ts"
    }
  },
  "bin": {
    "strict-lint": "dist/esm/bin/strict-lint.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "nmr build"
  },
  "dependencies": {
    "@williamthorsen/toolbelt.filesystem": "0.8.0",
    "@williamthorsen/toolbelt.packaging": "0.5.2"
  },
  "devDependencies": {
    "eslint": "catalog:"
  },
  "peerDependencies": {
    "eslint": ">=10"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
