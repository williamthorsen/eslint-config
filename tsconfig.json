// TSConfig for monorepo root. Packages have their own tsconfig.json files that extend this one.
{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@williamthorsen/tsconfig/tsconfig.base.json",
  "compilerOptions": {
    // Modern transformation by React 17+
    "jsx": "react-jsx",
    // On, the option makes a `.ts` extension on a `#src/` import error TS2877. `nmr-compile` turns it back on for
    // emit and rewrites the alias to a relative `.js` specifier itself.
    "rewriteRelativeImportExtensions": false,
    "types": ["node"],
  },
  // prettier-ignore
  "include": [
    ".config/**/*.ts",
    ".github/scripts/",
    "__tests__/",
    "packages/*/types/",
    "scripts/",
    "*.ts",
  ],
}
